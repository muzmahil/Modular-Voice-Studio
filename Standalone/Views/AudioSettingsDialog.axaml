<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ModularVoiceStudio.App.Views.AudioSettingsDialog"
        Title="Audio Hardware &amp; Driver Settings"
        Width="500"
        Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#181818"
        Foreground="#E0E0E0">

    <Border BorderBrush="#5C667A" BorderThickness="1.5" Background="#181818" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="AUDIO HARDWARE SETUP"
                               FontSize="13"
                               FontWeight="Black"
                               Foreground="#38BDF8"
                               VerticalAlignment="Center" />
                    <Border Background="#14331E" CornerRadius="2" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="LOW LATENCY DSP" FontSize="8" FontWeight="Bold" Foreground="#34D399" />
                    </Border>
                </Grid>
                <TextBlock Text="Configure physical audio devices, driver system, and buffer latency."
                           FontSize="9.5" Foreground="#888888" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Options Form -->
            <StackPanel Grid.Row="1" Spacing="12">
                <!-- Driver Type -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Audio Driver System:" FontSize="9.5" FontWeight="Bold" Foreground="#888888" />
                    <ComboBox Name="CmbDriver" HorizontalAlignment="Stretch" SelectedIndex="0" Background="#242424" BorderBrush="#383838" Height="28" FontSize="9.5">
                        <ComboBoxItem>Windows Audio (WASAPI / Low-Latency)</ComboBoxItem>
                        <ComboBoxItem>Windows DirectSound</ComboBoxItem>
                        <ComboBoxItem>ASIO Low-Latency Audio Driver</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- Input Device -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Microphone Input Device:" FontSize="9.5" FontWeight="Bold" Foreground="#888888" />
                    <ComboBox Name="CmbInput" HorizontalAlignment="Stretch" Background="#242424" BorderBrush="#383838" Height="28" FontSize="9.5" />
                </StackPanel>

                <!-- Output Device -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Monitor / Headphones Output Device:" FontSize="9.5" FontWeight="Bold" Foreground="#888888" />
                    <ComboBox Name="CmbOutput" HorizontalAlignment="Stretch" Background="#242424" BorderBrush="#383838" Height="28" FontSize="9.5" />
                </StackPanel>

                <!-- Buffer Size & Sample Rate -->
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Spacing="4" Margin="0,0,6,0">
                        <TextBlock Text="Sample Rate:" FontSize="9.5" FontWeight="Bold" Foreground="#888888" />
                        <ComboBox Name="CmbSampleRate" HorizontalAlignment="Stretch" SelectedIndex="1" Background="#242424" BorderBrush="#383838" Height="28" FontSize="9.5">
                            <ComboBoxItem>44,100 Hz</ComboBoxItem>
                            <ComboBoxItem>48,000 Hz (Broadcast)</ComboBoxItem>
                            <ComboBoxItem>96,000 Hz (Hi-Res)</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                        <TextBlock Text="Buffer Size (Latency):" FontSize="9.5" FontWeight="Bold" Foreground="#888888" />
                        <ComboBox Name="CmbBufferSize" HorizontalAlignment="Stretch" SelectedIndex="1" Background="#242424" BorderBrush="#383838" Height="28" FontSize="9.5">
                            <ComboBoxItem>64 Samples (1.3 ms)</ComboBoxItem>
                            <ComboBoxItem>128 Samples (2.7 ms)</ComboBoxItem>
                            <ComboBoxItem>256 Samples (5.3 ms)</ComboBoxItem>
                            <ComboBoxItem>512 Samples (10.6 ms)</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Buttons (Centering) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,18,0,0">
                <Button Content="Native JUCE Setup..."
                        FontSize="9"
                        FontWeight="Bold"
                        Height="28"
                        Padding="12,0"
                        Background="#252525"
                        Foreground="#CCCCCC"
                        BorderBrush="#383838"
                        BorderThickness="1"
                        CornerRadius="3"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnOpenJuceSetupClicked" />

                <Button Content="Close"
                        FontSize="9.5"
                        FontWeight="Bold"
                        Width="80"
                        Height="28"
                        Padding="0"
                        Background="#333333"
                        Foreground="#FFFFFF"
                        BorderBrush="#444444"
                        BorderThickness="1"
                        CornerRadius="3"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnCloseClicked" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
